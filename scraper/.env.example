# ============================================================
# BetRadar Scraper — .env.example
# Copie para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositório.
# ============================================================

# --- Telegram Bot ---
# Token obtido via @BotFather no Telegram
# Exemplo: 7123456789:AAF...xyz
TELEGRAM_BOT_TOKEN=seu_token_aqui

# --- Kafka ---
# Endereço do broker Kafka (host:porta)
# Para Docker local: localhost:29092 (conforme docker-compose.yml)
# Para múltiplos brokers: broker1:9092,broker2:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Nome do tópico onde as odds são publicadas
# Deve ser idêntico ao configurado no Spring Boot (spring.kafka.consumer.topics)
KAFKA_TOPIC=raw-odds

# --- Nível de log ---
# Valores válidos: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG apenas em desenvolvimento — muito verboso em produção
LOG_LEVEL=INFO

# Formato do log: 'simple' (legível) ou 'structured' (para sistemas de observabilidade)
LOG_FORMAT=simple

# --- Proxy (opcional — recomendado para Bet365 em produção) ---
# Usar proxy residencial para evitar bloqueios anti-bot da Bet365
# Formato: http://usuario:senha@host:porta
# Deixe em branco para não usar proxy
PROXY_URL=
